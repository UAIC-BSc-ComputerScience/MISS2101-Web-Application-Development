Prefix(:=<http://www.semanticweb.org/ontologies/2008/10/SWOnto.owl#>)
Prefix(dc:=<http://purl.org/dc/elements/1.1/>)
Prefix(owl:=<http://www.w3.org/2002/07/owl#>)
Prefix(rdf:=<http://www.w3.org/1999/02/22-rdf-syntax-ns#>)
Prefix(xml:=<http://www.w3.org/XML/1998/namespace>)
Prefix(xsd:=<http://www.w3.org/2001/XMLSchema#>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)
Prefix(SWOnto:=<http://www.semanticweb.org/ontologies/2008/10/SWOnto.owl#>)
Prefix(owl2xml:=<http://www.w3.org/2006/12/owl2-xml#>)


Ontology(<http://www.semanticweb.org/ontologies/2008/10/SWOnto.owl>
Annotation(rdfs:label "SWOnto"^^xsd:string)
Annotation(dc:creator "Sabin Buraga"^^xsd:string)
Annotation(rdfs:label "Ontologie demonstrativa folosita pentru exemplificarea unor concepte discutate la cursul 'Semantic Web'."^^xsd:string)
Annotation(dc:date "2009"^^xsd:dateTime)

Declaration(Class(:Audio))
SubClassOf(:Audio :Multimedia)
Declaration(Class(:Barbat))
EquivalentClasses(:Barbat ObjectHasValue(:areGen :Masculin))
SubClassOf(:Barbat :Persoana)
DisjointClasses(:Barbat :Femeie)
Declaration(Class(:Femeie))
EquivalentClasses(:Femeie ObjectHasValue(:areGen :Feminin))
SubClassOf(:Femeie :Persoana)
DisjointClasses(:Femeie :Barbat)
Declaration(Class(:Gen))
AnnotationAssertion(rdfs:comment :Gen "Specifica genul unei persoane."^^xsd:string)
SubClassOf(:Gen owl:Thing)
DisjointClasses(:Gen :Multimedia)
Declaration(Class(:LumiVirtuale))
SubClassOf(:LumiVirtuale owl:Thing)
DisjointClasses(:LumiVirtuale :Proprietar)
DisjointClasses(:LumiVirtuale :Video)
Declaration(Class(:Multimedia))
AnnotationAssertion(rdfs:comment :Multimedia "Clasa resurselor multimedia, include sub-clase specifice."^^xsd:string)
SubClassOf(:Multimedia owl:Thing)
DisjointClasses(:Multimedia :Gen)
DisjointClasses(:Multimedia :Proprietar)
Declaration(Class(:Persoana))
AnnotationAssertion(rdfs:comment :Persoana "Clasa persoanelor."^^xsd:string)
SubClassOf(:Persoana owl:Thing)
Declaration(Class(:Proprietar))
SubClassOf(:Proprietar :Persoana)
SubClassOf(:Proprietar owl:Thing)
DisjointClasses(:Proprietar :LumiVirtuale)
DisjointClasses(:Proprietar :Multimedia)
Declaration(Class(:Video))
SubClassOf(:Video :Multimedia)
DisjointClasses(:Video :LumiVirtuale)
Declaration(Class(owl:Thing))
Declaration(ObjectProperty(:areGen))
FunctionalObjectProperty(:areGen)
ObjectPropertyDomain(:areGen :Persoana)
ObjectPropertyRange(:areGen :Gen)
Declaration(ObjectProperty(:detine))
InverseObjectProperties(:detinutDe :detine)
ObjectPropertyDomain(:detine :Proprietar)
ObjectPropertyRange(:detine :Multimedia)
Declaration(ObjectProperty(:detinutDe))
InverseObjectProperties(:detinutDe :detine)
Declaration(ObjectProperty(:rudaCu))
SymmetricObjectProperty(:rudaCu)
ReflexiveObjectProperty(:rudaCu)
ObjectPropertyDomain(:rudaCu :Persoana)
ObjectPropertyRange(:rudaCu :Persoana)
Declaration(DataProperty(:areVarsta))
FunctionalDataProperty(:areVarsta)
DataPropertyDomain(:areVarsta :Persoana)
DataPropertyRange(:areVarsta xsd:positiveInteger)
Declaration(DataProperty(:dimensiune))
FunctionalDataProperty(:dimensiune)
DataPropertyDomain(:dimensiune :Multimedia)
DataPropertyRange(:dimensiune xsd:unsignedLong)
ClassAssertion(:Gen :Feminin)
ClassAssertion(owl:Thing :Feminin)
ClassAssertion(:Gen :Masculin)
ClassAssertion(owl:Thing :Masculin)
AnnotationAssertion(rdfs:comment :anca "Individ de tip 'Femeie', care detine diverse resurse multimedia, are o anumita varsta si e ruda cu alte persoane."^^xsd:string)
ClassAssertion(:Femeie :anca)
ClassAssertion(owl:Thing :anca)
SameIndividual(:anca :ancuta)
ObjectPropertyAssertion(:detine :anca :the_wall)
DataPropertyAssertion(:areVarsta :anca "24"^^xsd:byte)
AnnotationAssertion(rdfs:comment :ancuta "'Ancuta' este un individ identic cu 'Anca'."^^xsd:string)
ClassAssertion(owl:Thing :ancuta)
SameIndividual(:ancuta :anca)
ObjectPropertyAssertion(:rudaCu :ancuta :eugen)
ClassAssertion(:Barbat :eugen)
ClassAssertion(owl:Thing :eugen)
ObjectPropertyAssertion(:detine :eugen :zidul)
ClassAssertion(:Audio :the_eye)
ClassAssertion(owl:Thing :the_eye)
ObjectPropertyAssertion(:detinutDe :the_eye :anca)
AnnotationAssertion(rdfs:comment :the_wall "Un film de Pink Floyd"^^xsd:string)
ClassAssertion(:Video :the_wall)
ClassAssertion(owl:Thing :the_wall)
ObjectPropertyAssertion(:detinutDe :the_wall :ancuta)
DataPropertyAssertion(:dimensiune :the_wall "600"^^xsd:unsignedLong)
AnnotationAssertion(rdfs:comment :zidul "Un film din Romania."^^xsd:string)
ClassAssertion(:Video :zidul)
ClassAssertion(owl:Thing :zidul)
Declaration(AnnotationProperty(dc:creator))
Declaration(AnnotationProperty(dc:date))
DifferentIndividuals(:zidul :the_wall)
)
