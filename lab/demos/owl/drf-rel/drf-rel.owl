    <!-- http://drf.googlecode.com/svn/trunk/rel/drf-rel#CollaboratorOf -->

    <owl:ObjectProperty rdf:about="#CollaboratorOf">
        <rdf:type rdf:resource="&owl;SymmetricProperty"/>
        <rdfs:label xml:lang="en">Collaborator Of</rdfs:label>
        <rdfs:comment xml:lang="ro"
            >Relatia de colaborare intre persoane</rdfs:comment>
        <rdfs:domain rdf:resource="&foaf;Person"/>
        <rdfs:range rdf:resource="&foaf;Person"/>
        <rdfs:subPropertyOf rdf:resource="&foaf;knows"/>
    </owl:ObjectProperty>
    


    <!-- http://drf.googlecode.com/svn/trunk/rel/drf-rel#ProjectLeaderTo -->

    <owl:ObjectProperty rdf:about="#ProjectLeaderTo">
