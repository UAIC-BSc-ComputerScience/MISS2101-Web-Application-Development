        <dc:creator rdf:datatype="&xsd;string">Ciprian Amariei</dc:creator>
        <dc:title rdf:datatype="&xsd;string"
            >Relatii specificate pentru Date Review Framework</dc:title>
        <dc:contributor rdf:datatype="&xsd;string">Sabin Buraga</dc:contributor>
        <dc:description rdf:datatype="&xsd;string"
            >Vocabular descriind tipuri de relatii intre persoane, folosite in cadrul implementarii Date Review Framework.</dc:description>
    </owl:Ontology>
    


