        <owl:inverseOf rdf:resource="#WorkedUnderLeadershipOf"/>
        <rdfs:domain rdf:resource="&foaf;Person"/>
        <rdfs:range rdf:resource="&foaf;Person"/>
        <rdfs:subPropertyOf rdf:resource="&foaf;knows"/>
    </owl:ObjectProperty>
    


    <!-- http://drf.googlecode.com/svn/trunk/rel/drf-rel#ReviewedBy -->

    <owl:ObjectProperty rdf:about="#ReviewedBy">
        <rdfs:label
