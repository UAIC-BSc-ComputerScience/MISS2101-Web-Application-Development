    <!-- http://www.infoiasi.ro/SW/facultate#areEchipa -->

    <owl:ObjectProperty rdf:about="#areEchipa">
        <rdf:type rdf:resource="&owl;InverseFunctionalProperty"/>
        <rdfs:range rdf:resource="#Echipa"/>
        <rdfs:domain rdf:resource="#Proiect"/>
    </owl:ObjectProperty>
    


    <!-- http://www.infoiasi.ro/SW/facultate#areNevoieDe -->

    <owl:ObjectProperty rdf:about="#areNevoieDe">
        <rdfs:domain rdf:resource="#Persoana"/>
        <rdfs:range rdf:resource="#Resursa"/>
    </owl:ObjectProperty>
    


    <!-- http://www.infoiasi.ro/SW/facultate#areNevoieDeResursa -->

    <owl:ObjectProperty rdf:about="#areNevoieDeResursa">
        <rdfs:domain rdf:resource="#Echipa"/>
        <rdfs:range rdf:resource="#Resursa"/>
    </owl:ObjectProperty>
    


    <!-- http://www.infoiasi.ro/SW/facultate#areProiect -->

    <owl:ObjectProperty rdf:about="#areProiect">
        <rdf:type rdf:resource="&owl;InverseFunctionalProperty"/>
        <owl:inverseOf rdf:resource="#areEchipa"/>
    </owl:ObjectProperty>
    


    <!-- http://www.infoiasi.ro/SW/facultate#depindeDe -->

    <owl:ObjectProperty rdf:about="#depindeDe">
