        <rdfs:range rdf:resource="#Timp"/>
    </owl:ObjectProperty>
    


    <!-- http://www.infoiasi.ro/SW/facultate#utilizeaza -->

    <owl:ObjectProperty rdf:about="#utilizeaza">
