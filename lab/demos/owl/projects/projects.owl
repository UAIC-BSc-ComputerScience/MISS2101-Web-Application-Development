        <rdfs:comment rdf:datatype="&xsd;string"
            >Mod de lucru pentru managementul proiectelor.</rdfs:comment>
        <dc:contributor rdf:datatype="&xsd;string">Sabin Buraga</dc:contributor>
    </owl:Ontology>
    


    <!-- 
