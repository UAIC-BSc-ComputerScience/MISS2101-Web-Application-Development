        <owl:inverseOf rdf:resource="#esteFormataDin"/>
    </owl:ObjectProperty>
    


    <!-- http://www.infoiasi.ro/SW/facultate#include -->

    <owl:ObjectProperty rdf:about="#include">
        <rdfs:range rdf:resource="#Proiect"/>
