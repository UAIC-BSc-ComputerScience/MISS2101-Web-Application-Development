		"Nobelpriset i kemi 2022, Carolyn Bertozzi"@sv ;
	<http://data.nobelprize.org/terms/share> "3"^^xsd:integer ;
	<http://data.nobelprize.org/terms/motivation> "for the development of click chemistry and bioorthogonal chemistry"@en , "för utveckling av klickkemi och bioortogonal kemi"@sv ;
	<http://data.nobelprize.org/terms/year> "2022"^^xsd:integer ;
	<http://data.nobelprize.org/terms/laureate> <http://data.nobelprize.org/resource/laureate/1015> ;
	<http://data.nobelprize.org/terms/category> <http://data.nobelprize.org/resource/category/Chemistry> ;
	dcterms:isPartOf <http://data.nobelprize.org/resource/nobelprize/Chemistry/2022> ;
	<http://data.nobelprize.org/terms/university> 
		<http://data.nobelprize.org/resource/university/Stanford_University> , 
		<http://data.nobelprize.org/resource/university/Howard_Hughes_Medical_Institute> ;
	<http://data.nobelprize.org/terms/sortOrder> "1"^^xsd:integer .

