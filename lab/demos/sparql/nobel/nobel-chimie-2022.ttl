# premiul Nobel pentru chimie acordat in anul 2022... 
<http://data.nobelprize.org/resource/nobelprize/Chemistry/2022> 
	a <http://data.nobelprize.org/terms/NobelPrize> , <http://dbpedia.org/ontology/Award> ;
	rdfs:label "The Nobel Prize in Chemistry 2022"@en , "Nobelpriset i kemi 2022"@sv , "Nobelprisen i kjemi 2022"@no ;
	<http://data.nobelprize.org/terms/year> "2022"^^xsd:integer ;
	# ...are ca membri 3 entitati 
	<http://data.nobelprize.org/terms/laureate> 
		<http://data.nobelprize.org/resource/laureate/743> , 
		<http://data.nobelprize.org/resource/laureate/1015> , 
		<http://data.nobelprize.org/resource/laureate/1016> ;
	# ...care fac parte din multimea laureatilor Nobel	
	dcterms:hasPart 
		<http://data.nobelprize.org/resource/laureateaward/Chemistry/2022/1015> , 
		<http://data.nobelprize.org/resource/laureateaward/Chemistry/2022/743> , 
		<http://data.nobelprize.org/resource/laureateaward/Chemistry/2022/1016> ;
	# categoria premiului: chimie	
	<http://data.nobelprize.org/terms/category> <http://data.nobelprize.org/terms/Chemistry> ;
	<http://data.nobelprize.org/terms/categoryOrder> "2"^^xsd:integer .

# date privind un premiu identificat prin URI
<http://data.nobelprize.org/resource/laureateaward/Chemistry/2022/1015> 
	a <http://data.nobelprize.org/terms/LaureateAward> , <http://dbpedia.org/ontology/Award> ;
	rdfs:label "The Nobel Prize in Chemistry 2022, Carolyn Bertozzi"@en , 
